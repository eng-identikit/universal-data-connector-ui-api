# Copy to .env and change the values.

PORT=9000

# PostgreSQL (the database is created when missing)
UI_DB_HOST=localhost
UI_DB_PORT=5432
UI_DB_NAME=udc_ui
UI_DB_USER=udc
UI_DB_PASSWORD=change-me
# UI_DB_URL=postgres://user:pass@host:5432/udc_ui   (overrides the variables above)

# Long random strings:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
UI_JWT_SECRET=
UI_ENCRYPTION_KEY=

# First admin (local login); generated and logged once when empty
UI_ADMIN_USER=admin
UI_ADMIN_PASSWORD=

# UDC registered on the first start (optional)
# UDC_DEFAULT_NAME=UDC
# UDC_DEFAULT_URL=http://localhost:3000
# UDC_DEFAULT_PUBLIC_URL=https://udc.example.com
# UDC_DEFAULT_KEY=udc_...

# Keycloak login instead of local users (optional)
# KEYCLOAK_URL=https://keycloak.example.com
# KEYCLOAK_REALM=udc
# KEYCLOAK_CLIENT=udc-ui-api
# KEYCLOAK_UI_CLIENT=udc-ui
# KEYCLOAK_AUTHORIZED_ROLE=
# KEYCLOAK_ADMIN_ROLE=udc-admin
# KEYCLOAK_OPERATOR_ROLE=udc-operator
